[Unit]
Description=application-host — Angular dev server (port 4250)
Documentation=https://github.com/markpippins/nexus-application-host
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/codex/dev/nexus/angular/application-host
Environment=NODE_ENV=development
Environment=PORT=4250
ExecStart=/home/codex/.nvm/versions/node/v24.15.0/bin/npm start
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target